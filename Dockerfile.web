FROM oven/bun:1.2.20-alpine AS builder

WORKDIR /app

COPY package.json bun.lock turbo.json tsconfig.json ./
COPY apps ./apps
COPY packages ./packages

RUN bun install --frozen-lockfile
RUN bun run --cwd apps/web build

FROM nginx:1.27-alpine

RUN apk add --no-cache gettext

COPY deploy/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY deploy/web/runtime-config.template.js /usr/share/nginx/html/runtime-config.template.js
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

ENV APP_SERVER_URL=

EXPOSE 80

CMD ["/bin/sh", "-c", "envsubst '$APP_SERVER_URL' < /usr/share/nginx/html/runtime-config.template.js > /usr/share/nginx/html/runtime-config.js && exec nginx -g 'daemon off;'"]
